# Environment file for `systemd` (see deploy/chat-bot.service).
# Copy to /etc/chat-bot/chat-bot.env, chmod 600, then edit the values.
# systemd treats the whole right-hand side as the value: no inline comments.
#
# Required: the daemon refuses to start without a token file and a chat id.
CHATBOT_TOKEN_FILE=/etc/chat-bot/tg-bot.env
CHATBOT_CHAT_ID=-1001234567890
#
# Your own Telegram username (without @). Empty = nobody can open subagent
# dispatch from the chat.
CHATBOT_OWNER_USERNAME=your_telegram_username
#
# Optional, but recommended explicitly:
CHATBOT_USERNAME=your_bot_username
CHATBOT_STATE_DIR=/var/lib/chat-bot
CHATBOT_CWD=/opt/chat-bot
CHATBOT_AGENT_DIR=/var/lib/chat-bot/agent
CHATBOT_SESSION=chat-participant
CHATBOT_SYSTEM=system-prompt.md
CHATBOT_BATCH_SEC=10
