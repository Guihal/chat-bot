# Copy to .env, adjust, then `set -a; . ./.env; set +a` before starting chatd.
# Required values have no default on purpose: a missed value must stop the
# daemon, not point it at somebody else's chat.

# path of the file holding the RAW bot token (single line), mode 600 — REQUIRED
CHATBOT_TOKEN_FILE=/absolute/path/to/tg-bot.env

# Telegram chat id the bot serves, e.g. -1001234567890 — REQUIRED
CHATBOT_CHAT_ID=-1001234567890

# your Telegram username without @; empty = nobody can authorise subagents
CHATBOT_OWNER_USERNAME=

# numeric user id of the owner, fallback for accounts without a username
CHATBOT_OWNER_ID=

# username of the bot itself without @ (used to detect @mentions in the chat)
CHATBOT_USERNAME=

# where history.db, media/, events.jsonl, chatd.log and the host socket live
CHATBOT_STATE_DIR=./state

# ref name of the omo host session the bot drives
CHATBOT_SESSION=chat-participant

# dedicated host socket of this bot; default <CHATBOT_STATE_DIR>/host/rpc.sock.
# Never point two bots at one host: chat_send would leak into foreign sessions.
# CHATBOT_HOST_SOCKET=

# working directory handed to the agent session
CHATBOT_CWD=.

# batching window in seconds (messages collected before one push)
CHATBOT_BATCH_SEC=10

# system prompt file of the bot session
CHATBOT_SYSTEM=system-prompt.md

# isolated agent dir caused by provision-agent.sh (auth.json/models.json live there)
# CHATBOT_AGENT_DIR=

# model for one-shot subagents started from the chat; empty = current model
# CHATBOT_SUBAGENT_MODEL=

# staleness threshold for health.json poll_ok_at; the watchdog/health period
# is derived as this value / 2 (single setting, not two)
# CHATBOT_STALE_SEC=90

# systemd unit whose state decides the `down` verdict
# CHATBOT_SYSTEMD_UNIT=chat-bot.service

# optional external notifier (e.g. tg-notify); receives one `ALERT ...` string
# CHATBOT_NOTIFY_CMD=
